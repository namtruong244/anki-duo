{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "path-status",
  "type": "object",
  "required": ["description", "cases"],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"]
      }
    }
  }
}
