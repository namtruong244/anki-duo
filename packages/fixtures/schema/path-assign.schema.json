{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "path-assign",
  "type": "object",
  "required": ["description", "cases"],
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "lastNodeIndex", "lastNodeCount", "expected"],
        "properties": {
          "name": { "type": "string" },
          "lastNodeIndex": { "type": ["integer", "null"] },
          "lastNodeCount": { "type": "integer", "minimum": 0 },
          "expected": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sequences": { "type": "array" }
  }
}
