{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "donut",
  "type": "object",
  "required": ["description", "cases"],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
